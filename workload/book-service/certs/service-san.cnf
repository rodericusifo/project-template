[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[req_distinguished_name]
C = US
ST = California
L = San Francisco
O = My Organization
OU = IT
CN = $ENV::WORKLOAD

[v3_req]
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = $ENV::WORKLOAD
DNS.2 = localhost
IP.1 = 127.0.0.1

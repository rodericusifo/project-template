SHELL := /bin/bash
PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../..)
include $(PROJECT_ROOT)/colors.mk

# ENV VARIABLE
AVAILABLE_CACHE := redis

.PHONY: check-cache
check-cache:
	@$(PRINTF_CMD) "$(call log_action,Check App Cache ($(NAME) | $(ENV)))"
	@for cache in $(CACHE); do \
		if [[ ! " $(AVAILABLE_CACHE) " =~ " $${cache} " ]]; then \
			$(PRINTF_CMD) "$(RED)ERROR: Cache [$${cache}] is not available. Available Cache are: $(AVAILABLE_CACHE)$(NOCOLOR)"; \
			exit 1; \
		fi; \
	done
	@$(PRINTF_CMD) "$(call log_action_end,All Caches are available)"

.PHONY: run-cache
run-cache: check-cache
	@$(PRINTF_CMD) "$(call log_action,Start App Cache ($(NAME) | $(ENV)))"
	@for cache in $(CACHE); do \
		$(PRINTF_CMD) "$(call log_action,Generate App Cache Volumes [$${cache}] ($(NAME) | $(ENV)))"; \
		docker volume ls | grep $(SLUG)_primary_$${cache}_data_$(ENV) || docker volume create --name $(SLUG)_primary_$${cache}_data_$(ENV); \
		docker volume ls | grep $(SLUG)_replica_$${cache}_data_$(ENV) || docker volume create --name $(SLUG)_replica_$${cache}_data_$(ENV); \
		$(PRINTF_CMD) "$(call log_action,Start App Cache [$${cache}] ($(NAME) | $(ENV)))"; \
		ENV=$(ENV) SLUG=$(SLUG) docker compose -p $(NAME)_cache --env-file $${cache}/env/$(ENV).env -f $${cache}/docker-compose.yaml up --build -d; \
	done
	@$(PRINTF_CMD) "$(call log_action_end,Cache started successfully)"

.PHONY: stop-cache
stop-cache: check-cache
	@$(PRINTF_CMD) "$(call log_action,Stop App Cache ($(NAME) | $(ENV)))"
	@for cache in $(CACHE); do \
		$(PRINTF_CMD) "$(call log_action,Stop App Cache [$${cache}] ($(NAME) | $(ENV)))"; \
		ENV=$(ENV) SLUG=$(SLUG) docker compose -p $(NAME)_cache --env-file $${cache}/env/$(ENV).env -f $${cache}/docker-compose.yaml down; \
	done
	@$(PRINTF_CMD) "$(call log_action_end,Cache stopped successfully)"
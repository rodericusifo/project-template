SHELL := /bin/bash
PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../..)
include $(PROJECT_ROOT)/colors.mk

# ENV VARIABLE
AVAILABLE_MESSAGING := redpanda lavinmq

.PHONY: check-messaging
check-messaging:
	@$(PRINTF_CMD) "$(call log_action,Check App Messaging ($(NAME) | $(ENV)))"
	@for messaging in $(MESSAGING); do \
		if [[ ! " $(AVAILABLE_MESSAGING) " =~ " $${messaging} " ]]; then \
			$(PRINTF_CMD) "$(RED)ERROR: Messaging [$${messaging}] is not available. Available Messaging are: $(AVAILABLE_MESSAGING)$(NOCOLOR)"; \
			exit 1; \
		fi; \
	done
	@$(PRINTF_CMD) "$(call log_action_end,All Messaging are available)"

.PHONY: run-messaging
run-messaging: check-messaging
	@$(PRINTF_CMD) "$(call log_action,Start App Messaging ($(NAME) | $(ENV)))"
	@for messaging in $(MESSAGING); do \
		$(PRINTF_CMD) "$(call log_action,Generate App Messaging Volumes [$${messaging}] ($(NAME) | $(ENV)))"; \
		if [ "$${messaging}" == "redpanda" ]; then \
			docker volume ls | grep $(SLUG)_redpanda-0_data_$(ENV) || docker volume create --name $(SLUG)_redpanda-0_data_$(ENV); \
			docker volume ls | grep $(SLUG)_redpanda-1_data_$(ENV) || docker volume create --name $(SLUG)_redpanda-1_data_$(ENV); \
			docker volume ls | grep $(SLUG)_redpanda-2_data_$(ENV) || docker volume create --name $(SLUG)_redpanda-2_data_$(ENV); \
			docker volume ls | grep $(SLUG)_rustfs_data_$(ENV) || docker volume create --name $(SLUG)_rustfs_data_$(ENV); \
		elif [ "$${messaging}" == "lavinmq" ]; then \
			docker volume ls | grep $(SLUG)_lavinmq1_data_$(ENV) || docker volume create --name $(SLUG)_lavinmq1_data_$(ENV); \
			docker volume ls | grep $(SLUG)_lavinmq2_data_$(ENV) || docker volume create --name $(SLUG)_lavinmq2_data_$(ENV); \
			docker volume ls | grep $(SLUG)_lavinmq3_data_$(ENV) || docker volume create --name $(SLUG)_lavinmq3_data_$(ENV); \
			docker volume ls | grep $(SLUG)_etcd_data_$(ENV) || docker volume create --name $(SLUG)_etcd_data_$(ENV); \
    	else \
        	docker volume ls | grep $(SLUG)_$${messaging}_data_$(ENV) || docker volume create --name $(SLUG)_$${messaging}_data_$(ENV); \
    	fi; \
		$(PRINTF_CMD) "$(call log_action,Start App Messaging [$${messaging}] ($(NAME) | $(ENV)))"; \
		ENV=$(ENV) SLUG=$(SLUG) docker compose -p $(NAME)_messaging --env-file $${messaging}/env/$(ENV).env -f $${messaging}/docker-compose.yaml up --build -d; \
	done
	
	@$(PRINTF_CMD) "$(call log_action_end,Messaging started successfully)"

.PHONY: stop-messaging
stop-messaging: check-messaging
	@$(PRINTF_CMD) "$(call log_action,Stop App Messaging ($(NAME) | $(ENV)))"
	@for messaging in $(MESSAGING); do \
		$(PRINTF_CMD) "$(call log_action,Stop App Messaging [$${messaging}] ($(NAME) | $(ENV)))"; \
		ENV=$(ENV) SLUG=$(SLUG) docker compose -p $(NAME)_messaging --env-file $${messaging}/env/$(ENV).env -f $${messaging}/docker-compose.yaml down; \
	done
	@$(PRINTF_CMD) "$(call log_action_end,Messaging stopped successfully)"